# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# DiskWala API (Optional - if you have publisher account API key)
# Leave empty if you don't have one - bot will try alternative methods
DISKWALA_API_KEY=

# Download Settings
DOWNLOAD_DIR=./downloads
MAX_FILE_SIZE=2097152000

# Logging
LOG_LEVEL=INFO

# Bot Admin IDs (comma separated)
BOT_ADMIN_IDS=

# Allowed Users (leave empty for all users, comma separated user IDs)
ALLOWED_USERS=
